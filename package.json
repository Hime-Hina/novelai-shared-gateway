{
  "name": "novelai-shared-gateway",
  "version": "1.2.0",
  "description": "Self-hosted NovelAI Opus sharing gateway with member quotas and private administration.",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "build": "tsc -p tsconfig.backend.json && node scripts/package-backend.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "check": "node scripts/check.mjs",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "engines": {
    "node": "^22.23.3 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3@12.10.0"
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.4",
    "negotiator": "1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/negotiator": "0.6.5",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
