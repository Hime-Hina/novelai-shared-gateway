# 使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成管理员密钥。
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
# 另生成一份随机内部密钥，供 Nuxt 与执行器通信，不复用管理员密钥。
# web 仅获得此值和内部地址，不读取其他 .env 凭据；Caddy 不需要此密钥。
EXECUTOR_TOKEN=
# 仅首次初始化时需要；不要提交真实 PST。
NOVELAI_TOKEN=pst-replace-with-your-own-token
# 公网域名，不含协议；只本机使用时可保留示例值。
PUBLIC_HOST=gateway.example.com
PUBLIC_BASE_URL=https://gateway.example.com
# 可选的备用 API 域名，仅列主机名，多个域名用逗号分隔；管理员入口仍仅限本机。
PUBLIC_HOST_ALIASES=
# 登录限流仅信任这些直接/中间代理的精确 IP；留空则忽略所有转发头。
# systemd 同机 Caddy 通常填写 127.0.0.1,::1；Docker 请核对网关看到的代理来源地址，勿照抄回环地址。
# 不支持网段、主机名或 *；仅填写由你控制且正确覆盖/追加 X-Forwarded-For 的代理。
TRUSTED_PROXY_IPS=
# 未完成任务上限包含正在生成和等待中的任务；保持共享上游单并发。
QUEUE_MAX_ACTIVE_PER_MEMBER=4
QUEUE_MAX_ACTIVE_GLOBAL=16
# 未派发任务最长等待十分钟；已有请求的更短总超时仍然有效。
QUEUE_WAIT_TIMEOUT_MS=600000
# 正常退出等待在途结果与现有 HTTP 响应；到期后依靠持久状态恢复。最大 600000ms。
SHUTDOWN_GRACE_MS=30000
# F06 网页持久请求：规范化参数32MiB、活动参数合计64MiB；网页正文仍限2MiB。
# Native/direct/OpenAI 尚未接入此字节预算，不能据此声称全站内存受限。
REQUEST_MAX_PAYLOAD_BYTES=33554432
QUEUE_MAX_PAYLOAD_BYTES=67108864
# 设置任一 Discord 配置后关闭成员密码登录；三个值需完整填写才能授权。
# 回调地址为 PUBLIC_BASE_URL 的站点根域名 + /api/member/discord/callback。
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 可选：授予已绑定 Discord 的成员网页管理权限，填写内部成员 ID，不是用户名。
OWNER_USER_ID=
