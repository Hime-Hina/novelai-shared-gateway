[Unit]
Description=NovelAI gateway isolated test executor
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=novelai-gateway-test-executor
Group=novelai-gateway-test-executor
WorkingDirectory=/opt/novelai-shared-gateway-test/current/executor
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=19080
Environment=DATA_DIR=/var/lib/novelai-shared-gateway-test
Environment=SHUTDOWN_GRACE_MS=30000
Environment=NOVELAI_API_URL=http://127.0.0.1:19081
Environment=NOVELAI_ACCOUNT_API_URL=http://127.0.0.1:19081
EnvironmentFile=/etc/novelai-shared-gateway-test/executor.env
ExecStart=/opt/novelai-shared-gateway-test/current/bin/node /opt/novelai-shared-gateway-test/current/executor/.output/server/start.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/novelai-shared-gateway-test
IPAddressDeny=any
IPAddressAllow=localhost
MemoryHigh=512M
MemoryMax=768M
CPUQuota=75%
TasksMax=128

[Install]
WantedBy=multi-user.target
