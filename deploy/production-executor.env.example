# Runtime overrides loaded AFTER the existing gateway.env. Never copy test env here.
NODE_ENV=production
HOST=127.0.0.1
PORT=18082
DATA_DIR=/var/lib/novelai-shared-gateway
SHUTDOWN_GRACE_MS=30000
TRUSTED_PROXY_IPS=127.0.0.1,::1
NOVELAI_API_URL=https://image.novelai.net
NOVELAI_ACCOUNT_API_URL=https://image.novelai.net
# Generate once on the host; use the same value in production web.env.
EXECUTOR_TOKEN=replace-with-a-new-random-internal-token
