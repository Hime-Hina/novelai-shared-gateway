{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmitOnError": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    // 未迁移的 JS 仅发射到产物，不将 allowJs 视为已通过类型迁移。
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".output/backend"
  },
  "include": ["server/**/*", "public/**/*.js", "scripts/**/*.mjs"]
}
