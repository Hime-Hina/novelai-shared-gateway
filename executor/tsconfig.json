{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "novelai-shared-gateway/server/gateway-runtime.js": ["./types/gateway-runtime.d.ts"]
    }
  },
  "include": ["nitro.config.ts", "gateway-handler.ts", "executor-auth.mjs", "types/**/*.d.ts"]
}
