{
  "name": "@novelai-gateway/executor",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:runtime": "node --test tests/integration/runtime-http.test.mjs",
    "build": "pnpm --filter novelai-shared-gateway build && nitro build && node scripts/package-runtime.mjs",
    "start": "node .output/server/start.mjs"
  },
  "engines": { "node": "^22.23.4 || ^24.22.1 || >=26.12.1" },
  "dependencies": {
    "h3": "1.15.11",
    "novelai-shared-gateway": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "nitropack": "2.13.4",
    "typescript": "6.0.3"
  }
}
